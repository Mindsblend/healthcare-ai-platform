generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  email       String?      @unique
  phone       String?      @unique
  role        UserRole     @default(USER)
  firstName   String?
  lastName    String?
  addresses   Address[]
  aiResponses AiResponse[]
  carts       Cart[]
  orders      Order[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  firstName  String
  lastName   String
  phone      String
  email      String?
  province   String
  city       String
  address    String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  order     Order?
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  productId Int
  quantity  Int      @default(1)
  price     Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                 String      @id @default(cuid())
  userId             String?
  cartId             String      @unique
  totalPrice         Int
  status             OrderStatus @default(PENDING)
  createdAt          DateTime    @default(now())
  shippingAddress    String
  shippingCity       String
  shippingEmail      String
  shippingFirstName  String
  shippingLastName   String
  shippingNotes      String?
  shippingPhone      String
  shippingPostalCode String
  shippingProvince   String
  cart               Cart        @relation(fields: [cartId], references: [id])
  user               User?       @relation(fields: [userId], references: [id])
  items              OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId Int
  quantity  Int
  price     Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id          Int          @id @default(autoincrement())
  title       String       @unique
  price       Int
  image       String
  description String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  slug        String       @unique
  solution    String
  categoryId  Int
  isActive    Boolean      @default(true)
  aiResponses AiResponse[]
  cartItem    CartItem[]
  faqs        Faq[]
  gains       Gain[]
  icons       Icon[]
  orderItems  OrderItem[]
  category    Category     @relation(fields: [categoryId], references: [id])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  iconPath String
  products Product[]
}

model Icon {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  description String
  iconPath    String?
  product     Product @relation(fields: [productId], references: [id])
}

model Gain {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  ingredient  String
  description String
  product     Product @relation(fields: [productId], references: [id])
}

model Faq {
  id        Int     @id @default(autoincrement())
  productId Int
  question  String
  answer    String
  product   Product @relation(fields: [productId], references: [id])
}

model AiResponse {
  id             Int      @id @default(autoincrement())
  productId      Int
  userId         String?
  recommendation String
  explanation    String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  image       String
  description String
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorImage String
}

model VisitMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

enum UserRole {
  USER
  ADMIN
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}
