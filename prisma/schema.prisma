generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(cuid())
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  email             String?            @unique
  phone             String?            @unique
  role              UserRole           @default(USER)
  firstName         String?
  lastName          String?
  addresses         Address[]
  aiResponses       AiResponse[]
  carts             Cart[]
  healthAssessments HealthAssessment[]
  orders            Order[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  firstName  String
  lastName   String
  phone      String
  email      String?
  province   String
  city       String
  address    String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  order     Order?
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  productId Int
  quantity  Int      @default(1)
  price     Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  cartId              String      @unique
  totalPrice          Int
  status              OrderStatus @default(PENDING)
  createdAt           DateTime    @default(now())
  shippingAddress     String
  shippingCity        String
  shippingEmail       String
  shippingFirstName   String
  shippingLastName    String
  shippingNotes       String?
  shippingPhone       String
  shippingPostalCode  String
  shippingProvince    String
  canceledAt          DateTime?
  cancellationReason  String?
  paymentAuthority    String?     @unique
  paymentErrorMessage String?
  paymentMethod       String?
  paymentRefId        String?
  paymentRequestedAt  DateTime?
  paymentVerifiedAt   DateTime?
  refundReason        String?
  refundedAt          DateTime?
  updatedAt           DateTime    @updatedAt
  cart                Cart        @relation(fields: [cartId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId Int
  quantity  Int
  price     Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  title                 String                 @unique
  price                 Int
  image                 String
  description           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  slug                  String                 @unique
  solution              String
  categoryId            Int
  isActive              Boolean                @default(true)
  feedCategoryId        Int?
  discount              Int?                   @default(0)
  discountedPrice       Int?
  aiResponses           AiResponse[]
  cartItem              CartItem[]
  collectionProducts    CollectionProduct[]
  faqs                  Faq[]
  gains                 Gain[]
  healthRecommendations HealthRecommendation[]
  icons                 Icon[]
  orderItems            OrderItem[]
  category              Category               @relation(fields: [categoryId], references: [id])
  feedCategory          FeedCategory?          @relation(fields: [feedCategoryId], references: [id])
}

model Collection {
  id          Int                 @id @default(autoincrement())
  name        String              @unique
  slug        String              @unique
  subtitle    String?
  description String
  image       String
  price       Int
  isActive    Boolean             @default(true)
  featured    Boolean             @default(false)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  id           Int        @id @default(autoincrement())
  collectionId Int
  productId    Int
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  iconPath String
  products Product[]
}

model FeedCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Icon {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  description String
  iconPath    String?
  product     Product @relation(fields: [productId], references: [id])
}

model Gain {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  ingredient  String
  description String
  product     Product @relation(fields: [productId], references: [id])
}

model Faq {
  id        Int     @id @default(autoincrement())
  productId Int
  question  String
  answer    String
  product   Product @relation(fields: [productId], references: [id])
}

model AiResponse {
  id             Int      @id @default(autoincrement())
  productId      Int
  userId         String?
  recommendation String
  explanation    String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
}

model HealthAssessment {
  id               String                 @id @default(cuid())
  userId           String
  answers          Json
  sleepScore       Int
  nutritionScore   Int
  activityScore    Int
  stressScore      Int
  beautyScore      Int
  medicalScore     Int
  overallScore     Int
  healthArchetype  String?
  readinessStage   String?
  decisionStyle    String?
  consistencyLevel String?
  motivationSource String?
  isActive         Boolean                @default(true)
  completedAt      DateTime               @default(now())
  lastViewedAt     DateTime?
  aiOutput         Json?
  domains          Json?
  causalChain      Json?
  diagnosis        String?
  futureProjection Json?
  goals            Json?
  keyInsight       String?
  mainBottleneck   Json?
  priorityFactors  Json?
  startingPoint    Json?
  summary          String?
  whyThisMatters   String?
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations  HealthRecommendation[]

  @@index([userId])
  @@index([overallScore])
  @@index([healthArchetype])
  @@index([readinessStage])
}

model HealthRecommendation {
  id                    String           @id @default(cuid())
  healthAssessmentId    String
  productId             Int
  reason                String
  domain                String
  priority              Int              @default(1)
  createdAt             DateTime         @default(now())
  recommendationBatchId String?
  healthAssessment      HealthAssessment @relation(fields: [healthAssessmentId], references: [id], onDelete: Cascade)
  product               Product          @relation(fields: [productId], references: [id])

  @@unique([healthAssessmentId, productId])
  @@index([healthAssessmentId])
  @@index([productId])
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  image       String
  description String
  author      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  authorImage String
  content     String
  slug        String   @unique
  authorTitle String
}

model VisitMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
  DELIVERING
  DELIVERED
  PREPARING
}
