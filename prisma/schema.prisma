datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(cuid())
  firstName         String?
  lastName          String?
  phone             String?            @unique
  email             String?            @unique
  role              UserRole           @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  addresses         Address[]
  aiResponses       AiResponse[]
  carts             Cart[]
  healthAssessments HealthAssessment[]
  orders            Order[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  firstName  String
  lastName   String
  phone      String
  email      String?
  province   String
  city       String
  address    String
  postalCode String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  order     Order?
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    String
  productId Int
  quantity  Int      @default(1)
  price     Int
  createdAt DateTime @default(now())
  cart      Cart     @relation(fields: [cartId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
}

model Order {
  id                  String      @id @default(cuid())
  userId              String?
  cartId              String      @unique
  totalPrice          Int
  status              OrderStatus @default(PENDING)
  paymentMethod       String?
  paymentAuthority    String?     @unique
  paymentRefId        String?
  paymentRequestedAt  DateTime?
  paymentVerifiedAt   DateTime?
  paymentErrorMessage String?
  cancellationReason  String?
  canceledAt          DateTime?
  refundReason        String?
  refundedAt          DateTime?
  shippingFirstName   String
  shippingLastName    String
  shippingEmail       String
  shippingPhone       String
  shippingCity        String
  shippingProvince    String
  shippingAddress     String
  shippingPostalCode  String
  shippingNotes       String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  cart                Cart        @relation(fields: [cartId], references: [id])
  user                User?       @relation(fields: [userId], references: [id])
  items               OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   String
  productId Int
  quantity  Int
  price     Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
}

model Product {
  id                    Int                    @id @default(autoincrement())
  title                 String                 @unique
  slug                  String                 @unique
  solution              String
  description           String
  price                 Int
  image                 String
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  categoryId            Int
  feedCategoryId        Int?
  aiResponses           AiResponse[]
  cartItem              CartItem[]
  faqs                  Faq[]
  gains                 Gain[]
  healthRecommendations HealthRecommendation[]
  icons                 Icon[]
  orderItems            OrderItem[]
  category              Category               @relation(fields: [categoryId], references: [id])
  feedCategory          FeedCategory?          @relation(fields: [feedCategoryId], references: [id])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  iconPath String
  products Product[]
}

model FeedCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Icon {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  description String
  iconPath    String?
  product     Product @relation(fields: [productId], references: [id])
}

model Gain {
  id          Int     @id @default(autoincrement())
  productId   Int
  title       String
  ingredient  String
  description String
  product     Product @relation(fields: [productId], references: [id])
}

model Faq {
  id        Int     @id @default(autoincrement())
  productId Int
  question  String
  answer    String
  product   Product @relation(fields: [productId], references: [id])
}

model AiResponse {
  id             Int      @id @default(autoincrement())
  productId      Int
  userId         String?
  recommendation String
  explanation    String
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id])
  user           User?    @relation(fields: [userId], references: [id])
}

model HealthAssessment {
  id               String                 @id @default(cuid())
  userId           String
  answers          Json
  sleepScore       Int
  nutritionScore   Int
  activityScore    Int
  stressScore      Int
  beautyScore      Int
  medicalScore     Int
  overallScore     Int
  aiOutput         Json?
  healthArchetype  String?
  readinessStage   String?
  decisionStyle    String?
  consistencyLevel String?
  motivationSource String?
  domains          Json?
  summary          String?
  diagnosis        String?
  keyInsight       String?
  whyThisMatters   String?
  causalChain      Json?
  mainBottleneck   Json?
  startingPoint    Json?
  priorityFactors  Json?
  futureProjection Json?
  goals            Json?
  isActive         Boolean                @default(true)
  completedAt      DateTime               @default(now())
  lastViewedAt     DateTime?
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations  HealthRecommendation[]

  @@index([userId])
  @@index([overallScore])
  @@index([healthArchetype])
  @@index([readinessStage])
}

model HealthRecommendation {
  id                    String           @id @default(cuid())
  healthAssessmentId    String
  productId             Int
  reason                String
  domain                String
  priority              Int              @default(1)
  recommendationBatchId String?
  createdAt             DateTime         @default(now())
  healthAssessment      HealthAssessment @relation(fields: [healthAssessmentId], references: [id], onDelete: Cascade)
  product               Product          @relation(fields: [productId], references: [id])

  @@unique([healthAssessmentId, productId])
  @@index([healthAssessmentId])
  @@index([productId])
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  image       String
  description String
  slug        String   @unique
  content     String
  author      String
  authorImage String
  authorTitle String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

enum OrderStatus {
  PENDING
  PREPARING
  PAID
  DELIVERING
  DELIVERED
  FAILED
  CANCELED
  REFUNDED
}
