generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(cuid())
  firstName  String?
  lastName   String?
  phone      String? @unique
  email      String? @unique

  role       UserRole @default(USER)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  aiResponses AiResponse[] // TODO: Delete this since we are taking care of the ai results from the health assessments
  carts       Cart[]
  orders      Order[]
  addresses   Address[]
  healthAssessments HealthAssessment[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  firstName  String
  lastName   String
  phone      String
  email      String?
  province   String
  city       String
  address    String
  postalCode String
  
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

model Cart {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  status CartStatus @default(ACTIVE)

  items  CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order?
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

model CartItem {
  id Int @id @default(autoincrement())

  cart   Cart   @relation(fields: [cartId], references: [id])
  cartId String

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity Int @default(1)
  price    Int // قیمت محصول در زمان اضافه شدن به سبد

  createdAt DateTime @default(now())

  @@unique([cartId, productId])
}

model Order {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  cart   Cart   @relation(fields: [cartId], references: [id])
  cartId String @unique

  totalPrice Int

  status OrderStatus @default(PENDING)

  // Payment fields
  paymentMethod       String?   // 'zarinpal' or 'mellat'
  paymentAuthority    String?   @unique
  paymentRefId        String?
  paymentRequestedAt  DateTime?
  paymentVerifiedAt   DateTime?
  paymentErrorMessage String?

  // Cancellation/Refund fields
  cancellationReason  String?
  canceledAt          DateTime?
  refundReason        String?
  refundedAt          DateTime?

  shippingFirstName   String
  shippingLastName    String
  shippingEmail       String
  shippingPhone       String
  shippingCity        String
  shippingProvince    String
  shippingAddress     String
  shippingPostalCode  String
  shippingNotes       String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id Int @id @default(autoincrement())

  order   Order   @relation(fields: [orderId], references: [id])
  orderId String

  product   Product @relation(fields: [productId], references: [id])
  productId Int

  quantity Int
  price    Int // snapshot of price at purchase

  createdAt DateTime @default(now())
}

enum OrderStatus {
  PENDING      // Payment pending / not yet paid
  PREPARING    // Preparing order for delivery
  PAID         // Payment successful, order confirmed
  DELIVERING   // Shipped and on the way to customer
  DELIVERED    // Successfully delivered to customer
  FAILED       // Payment failed
  CANCELED     // Canceled by customer or admin
  REFUNDED     // Money returned to customer
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  slug        String   @unique
  solution    String
  description String
  price       Int
  image       String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  categoryId  Int
  category    Category     @relation(fields: [categoryId], references: [id])
  feedCategory   FeedCategory? @relation(fields: [feedCategoryId], references: [id])
  feedCategoryId Int?
  icons       Icon[] // Top 3 risk removals or trust signals
  gains       Gain[] // Top 3 benefits
  faqs        Faq[] // Frequently asked questions
  aiResponses AiResponse[] // AI test results or recommendations
  cartItem    CartItem[]
  orderItems OrderItem[]
  healthRecommendations HealthRecommendation[] // Products recommended by AI
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  iconPath String
  products Product[]
}

model FeedCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique  // e.g., "Trending", "New Arrivals", "Best Sellers"
  slug     String    @unique
  description String
  order    Int       @default(0) // For sorting in the feed
  
  products Product[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Icon {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  title       String // e.g., بدون وابستگی مصرف
  description String // required, short explanation
  iconPath    String?
}

model Gain {
  id          Int     @id @default(autoincrement())
  product     Product @relation(fields: [productId], references: [id])
  productId   Int
  title       String // e.g., ضد التهاب
  ingredient  String // e.g., نیاسینامید
  description String // e.g., قرمزی و تحریک پوست را کاهش می‌دهد
}

model Faq {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int
  question  String
  answer    String
}

model AiResponse {
  id        Int     @id @default(autoincrement())
  product   Product @relation(fields: [productId], references: [id])
  productId Int

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  recommendation String
  explanation    String
  createdAt      DateTime @default(now())
}

model HealthAssessment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  answers       Json

  sleepScore    Int
  nutritionScore Int
  activityScore Int
  stressScore   Int
  beautyScore   Int
  medicalScore  Int
  overallScore  Int

  // FULL AI STRUCTURED OUTPUT
  aiOutput      Json?

  // Behavioral insights
  healthArchetype    String?
  readinessStage     String?
  decisionStyle      String?
  consistencyLevel   String?
  motivationSource   String?

  // SYSTEM STATE (NEW - CRITICAL)
  domains        Json?

  // Metadata
  isActive      Boolean  @default(true)
  completedAt   DateTime @default(now())
  lastViewedAt  DateTime?

  recommendations HealthRecommendation[]

  @@index([userId])
  @@index([overallScore])
  @@index([healthArchetype])
  @@index([readinessStage])
}

model HealthRecommendation {
  id                 String   @id @default(cuid())
  healthAssessmentId String
  healthAssessment   HealthAssessment @relation(fields: [healthAssessmentId], references: [id], onDelete: Cascade)

  productId          Int
  product            Product  @relation(fields: [productId], references: [id])

  reason             String   @db.Text
  domain             String
  priority           Int      @default(1)

  recommendationBatchId String?

  createdAt          DateTime @default(now())

  @@unique([healthAssessmentId, productId])
  @@index([healthAssessmentId])
  @@index([productId])
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String   @unique
  image       String
  description String
  slug        String   @unique
  content     String
  author      String
  authorImage String
  authorTitle String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model VisitMonth {
  id        String   @id @default(cuid())
  year      Int
  month     Int
  visits    Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([year, month])
}

model Subscription {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}